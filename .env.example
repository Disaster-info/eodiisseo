# 1. 로컬 DB [필수]
DB_URL=jdbc:postgresql://127.0.0.1:55432/eodiisseo_local
DB_USERNAME=eodiisseo_app
DB_PASSWORD=

# 2. JWT와 회원 세션 [필수]
JWT_SECRET=
JWT_ISSUER=eodiisseo
JWT_AUDIENCE=eodiisseo-mobile
JWT_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=1209600
MEMBER_RETENTION_SWEEP_MS=3600000
AUTH_BRIDGES_ENABLED=true

# 3. 기상청 날씨 [현재 코드 호환 설정]
KMA_SERVICE_KEY=
DATA_GO_KR_SERVICE_KEY=
KMA_WEATHER_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
WEATHER_SOURCE_ENDPOINT_KEY=WEATHER_API
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_AFTER_SECONDS=7200
WEATHER_FALLBACK_MAX_AGE_SECONDS=10800
LOCATION_STALE_AFTER_SECONDS=300

# 4. 재난안전데이터공유플랫폼 [현재 코드 호환 설정]
SAFETYDATA_EARTHQUAKE_SHELTER_KEY=
SAFETYDATA_EARTHQUAKE_HOUSING_KEY=
SAFETYDATA_VICTIM_HOUSING_KEY=
SAFETYDATA_DISASTER_MESSAGE_KEY=

# 5. TMAP 보행자 경로 [기능 필수]
TMAP_APP_KEY=
TMAP_CONNECT_TIMEOUT_MS=2000
TMAP_ROUTE_RESPONSE_TIMEOUT_MS=10000
SHELTER_INITIAL_RADIUS_KM=1
SHELTER_REFRESH_ON_QUERY=false
SHELTER_RADIUS_STEP_KM=1
SHELTER_MAX_RADIUS_KM=5

# 6. Google 로그인 [기능 필수]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:8081,http://localhost:8081/,http://127.0.0.1:8081,http://127.0.0.1:8081/

# 7. Kakao 로그인 [기능 필수]
KAKAO_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 8. FCM 알림
FCM_SERVICE_ACCOUNT_PATH=
eodiisseo.fcm.enabled=false
EODIISSEO_NOTIFICATION_TOKEN_KEY_PATH=
eodiisseo.notification.auth.enabled=false
eodiisseo.notification.crypto.enabled=false
eodiisseo.notification.persistence.enabled=false
eodiisseo.owned-http.enabled=false

# 9. AI Ollama [AI 생성 사용 시 기능 필수]
EODIISSEO_AI_OLLAMA_ENABLED=false
EODIISSEO_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
EODIISSEO_AI_OLLAMA_MODEL=
EODIISSEO_AI_OLLAMA_REQUEST_TIMEOUT=PT30S
EODIISSEO_AI_OLLAMA_CONNECT_TIMEOUT=PT5S
EODIISSEO_AI_OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost,::1
LLM_API_KEY=

# 10. Redis [연결 예정]
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 11. 실행 모드와 브라우저 접근 [선택]
USE_MOCK_DISASTER_API=false
MOCK_API_ENABLED=false
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*

# 12. PD-001 산불위험예보정보
FOREST_SERVICE_KEY=
FOREST_BASE_URL=https://apis.data.go.kr/1400377/forestPointV2

# 13. PD-002 민방위대피시설
CIVIL_SHELTER_SERVICE_KEY=
CIVIL_SHELTER_BASE_URL=https://apis.data.go.kr/1741000/civil_defense_shelter_info

# 14. PD-003·004·005 기상특보·지진·단기예보
KMA_PUBLIC_SERVICE_KEY=
KMA_WARNING_BASE_URL=https://apis.data.go.kr/1360000/WthrWrnInfoService
KMA_EARTHQUAKE_BASE_URL=https://apis.data.go.kr/1360000/EqkInfoService

# 15. SD-001 지진옥외대피장소
SAFETY_SERVICE_KEY=

# 16. SD-002 지진겸용 임시주거시설
SAFETY_EQ_TEMP_KEY=

# 17. SD-003 이재민 임시주거시설
SAFETY_TEMP_KEY=

# 18. SD-004 긴급재난문자 [문서의 SAFETY_SERVICE_KEY는 SD-001과 별도 키]
SAFETY_DISASTER_MESSAGE_KEY=

# 19. KH-001·002·003 기상청 API 허브
KMA_HUB_AUTH_KEY=
KMA_HUB_INFORMATION_URL=https://apihub.kma.go.kr/api/typ01/url/wrn_inf_rpt.php
KMA_HUB_WARNING_URL=https://apihub.kma.go.kr/api/typ01/url/wrn_met_data.php
KMA_HUB_REGION_URL=https://apihub.kma.go.kr/api/typ01//url/wrn_reg.php

# 20. TM-001 TMAP 보행자 경로
TMAP_BASE_URL=https://apis.openapi.sk.com
TMAP_PEDESTRIAN_URL=https://apis.openapi.sk.com/tmap/routes/pedestrian?version=1

# 21. 위치 갱신
LOCATION_WRITE_REQUESTS_PER_MINUTE=60

# 22. 외부 자료 수집 worker
COLLECTION_WORKER_ENABLED=false
COLLECTION_POLL_INTERVAL_MS=1000
COLLECTION_SCHEDULE_INTERVAL_MS=60000
