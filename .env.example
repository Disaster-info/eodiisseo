# 주의: 주석은 반드시 줄 맨 앞에 # 로 쓴다 (KEY=값 뒤에 # 을 붙이면 값에 포함됨)

# ─── 공공데이터 ───────────────────────────────
# 공공데이터포털 (기상청 지진정보·기상특보·단기예보)
DATA_GO_KR_SERVICE_KEY=
# 재난안전데이터공유플랫폼 — API마다 서비스키가 따로 발급됨 (외부 API 정리본 SD-001~004)
# SD-001 지진옥외대피장소 (대피소 조회에 사용)
SAFETYDATA_EARTHQUAKE_SHELTER_KEY=
# SD-002 지진겸용 임시주거시설
SAFETYDATA_EARTHQUAKE_HOUSING_KEY=
# SD-003 이재민 임시주거시설
SAFETYDATA_VICTIM_HOUSING_KEY=
# SD-004 긴급재난문자
SAFETYDATA_DISASTER_MESSAGE_KEY=

# ─── 지도 / 경로 ──────────────────────────────
# TM-001 보행자 경로안내 (서버에서만 사용, 앱에 넣지 않음)
TMAP_APP_KEY=

# ─── 로그인 ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_SECRET=
JWT_SECRET=

# ─── 알림 / AI ────────────────────────────────
FCM_SERVICE_ACCOUNT_PATH=
LLM_API_KEY=

# ─── DB ───────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/eodiisseo
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── 실행 모드 ────────────────────────────────
# true면 외부 재난 API 대신 mock-data 사용 (FR-TEST-004)
USE_MOCK_DISASTER_API=false

# ─── 선택: 운영 정책값 (API 명세서 "지도 운영 설정") ──
# 비워 두면 기본값 사용. 바꿀 때만 주석을 풀어 값 입력
# TMAP_CONNECT_TIMEOUT_MS=2000
# TMAP_ROUTE_RESPONSE_TIMEOUT_MS=10000
# SHELTER_INITIAL_RADIUS_KM=1
# SHELTER_RADIUS_STEP_KM=1
# SHELTER_MAX_RADIUS_KM=5
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*
