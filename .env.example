# ─── 공공데이터 ───────────────────────────────
# 공공데이터포털 (기상청 지진정보·기상특보·단기예보)
DATA_GO_KR_SERVICE_KEY=
# 재난안전데이터공유플랫폼 (긴급재난문자, 대피소, 국민행동요령)
SAFETYDATA_SERVICE_KEY=

# ─── 지도 / 경로 ──────────────────────────────
KAKAO_REST_API_KEY=
KAKAO_NATIVE_APP_KEY=
TMAP_APP_KEY=

# ─── 로그인 ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_SECRET=
JWT_SECRET=

# ─── 알림 / AI ────────────────────────────────
FCM_SERVICE_ACCOUNT_PATH=
LLM_API_KEY=

# ─── DB ───────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/eodiisseo
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── 실행 모드 ────────────────────────────────
# true면 외부 재난 API 대신 mock-data 사용 (FR-TEST-004)
USE_MOCK_DISASTER_API=false

# 담당 백엔드 인증 설정. 기존 GOOGLE_CLIENT_ID도 단일 ID로 사용할 수 있습니다.
GOOGLE_CLIENT_IDS=
KAKAO_APP_ID=
JWT_ISSUER=eodiisseo
JWT_AUDIENCE=eodiisseo-mobile
JWT_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=1209600
MEMBER_RETENTION_SWEEP_MS=3600000
# KMA_SERVICE_KEY 미설정 시 DATA_GO_KR_SERVICE_KEY를 사용합니다.
KMA_SERVICE_KEY=
WEATHER_SOURCE_ENDPOINT_KEY=WEATHER_API
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_AFTER_SECONDS=7200
WEATHER_FALLBACK_MAX_AGE_SECONDS=10800
LOCATION_STALE_AFTER_SECONDS=300
