# 이 파일을 .env.local 로 복사해 값을 채우세요. (.env.local 은 git 에 올라가지 않음)
# EXPO_PUBLIC_ 로 시작하는 값은 앱 코드에 그대로 들어가므로 비밀값(Client Secret 등)은 넣지 않습니다.

# TMAP (SK open API) 앱 키 — 지도·장소 검색·도보 경로
EXPO_PUBLIC_TMAP_APP_KEY=

# 백엔드 주소 (기본 http://localhost:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080

# 웹 소셜 로그인 (인가 코드는 백엔드가 토큰으로 교환. Client Secret 은 백엔드 .env 에만)
# Google Cloud Console > OAuth 클라이언트 ID(웹 애플리케이션). 백엔드 GOOGLE_CLIENT_ID 에도 같은 값
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 카카오 디벨로퍼스 > 앱 키 > REST API 키. 백엔드 KAKAO_REST_API_KEY 에도 같은 값
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# 앱(iOS·Android) 네이티브 로그인 — 개발 빌드에서만 동작 (Expo Go 는 목업 로그인)
# Google Cloud Console > OAuth 클라이언트 ID(iOS, 번들 ID com.disasterinfo.eodiisseo). Android 는 클라이언트(패키지명 + SHA-1)만 만들면 값은 필요 없음
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# 카카오 디벨로퍼스 > 앱 키 > 네이티브 앱 키 (REST API 키와 다름). 플랫폼에 iOS 번들 ID·Android 패키지명·키 해시 등록
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
