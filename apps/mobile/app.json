{
  "expo": {
    "name": "어디있어",
    "slug": "Disaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.disasterinfo.eodiisseo"
    },
    "android": {
      "package": "com.disasterinfo.eodiisseo",
      "adaptiveIcon": {
        "backgroundColor": "#D7EAF3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "어디있어",
      "shortName": "어디있어",
      "lang": "ko",
      "description": "실시간 재난 정보와 가까운 대피소, 가족 안심 확인",
      "themeColor": "#0B4A6B",
      "backgroundColor": "#E7EAF0"
    },
    "plugins": [
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 대피소와 대피 경로를 안내하기 위해 현재 위치를 사용합니다."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D7EAF3",
          "dark": {
            "backgroundColor": "#121416"
          }
        }
      ]
    ],
    "scheme": "eodiisseo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
