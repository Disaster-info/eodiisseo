  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "흰 글자를 얹는 꽉 찬 주 버튼. fill 바탕, 높이 52.",
      "html": "<button class=\"ds-btn\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 512 512\" fill=\"currentColor\"><path d=\"M448 64 32 240l176 64 64 176z\"/></svg>대피소 찾기</button>",
      "css": ".ds-btn{display:flex;gap:8px;align-items:center;justify-content:center;min-height:52px;padding:0 12px;border:0;border-radius:10px;background:#0B5CAD;color:#FFFFFF;font:700 17px system-ui;width:100%;transition:opacity .1s}.ds-btn:active{opacity:.7}.ds-btn:focus-visible{outline:3px solid #0A4C8F;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "보조 행동. 카드 바탕 + 1.5px 글자용 색 테두리. 파괴적 동작은 danger 색.",
      "html": "<button class=\"ds-btn-o\">그룹 탈퇴</button>",
      "css": ".ds-btn-o{min-height:52px;padding:0 12px;width:100%;border:1.5px solid #B3201A;border-radius:10px;background:#FFFFFF;color:#B3201A;font:700 17px system-ui}.ds-btn-o:active{opacity:.7}.ds-btn-o:focus-visible{outline:3px solid #0B5CAD;outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "알약형 선택 칩. 선택 시 fill 바탕 + 흰 글자. 높이 44.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip on\">현재 위치</button><button class=\"ds-chip\">서울 마포구</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chip{min-height:44px;padding:9px 14px;border:1px solid #D9DCD8;border-radius:999px;background:#FFFFFF;color:#16181B;font:500 15px system-ui}.ds-chip.on{background:#0B5CAD;border-color:#0B5CAD;color:#FFFFFF}.ds-chip:active{opacity:.7}.ds-chip:focus-visible{outline:3px solid #0B5CAD;outline-offset:2px}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "중립 카드. 색 없음, 옅은 그림자 하나, 12 모서리.",
      "html": "<div class=\"ds-card\"><b>서울 마포구</b><p>발생 10:20 · 갱신 10:42</p></div>",
      "css": ".ds-card{background:#FFFFFF;border-radius:12px;padding:16px;box-shadow:0 1px 3px rgba(22,24,27,.08);font:17px/24px system-ui;color:#16181B}.ds-card p{margin:2px 0 0;font-size:15px;line-height:22px;color:#5C6168}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "콘크리트 바탕 입력칸.",
      "html": "<input class=\"ds-input\" placeholder=\"예: FRD-1234\">",
      "css": ".ds-input{border:1px solid #D9DCD8;border-radius:10px;padding:12px 14px;font:17px system-ui;background:#F2F3F1;color:#16181B;width:100%}.ds-input:focus-visible{outline:2px solid #0B5CAD;outline-offset:1px}"
    },
    {
      "name": "Segmented",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "2~4개 중 하나. 선택 칸은 카드 바탕 + 옅은 그림자.",
      "html": "<div class=\"ds-seg\"><button class=\"on\">거리순</button><button>이름순</button></div>",
      "css": ".ds-seg{display:flex;gap:3px;padding:3px;border-radius:10px;background:#D9DCD8}.ds-seg button{flex:1;min-height:44px;border:0;border-radius:8px;background:transparent;color:#5C6168;font:500 15px system-ui}.ds-seg button.on{background:#FFFFFF;color:#16181B;font-weight:700;box-shadow:0 1px 3px rgba(22,24,27,.08)}.ds-seg button:focus-visible{outline:3px solid #0B5CAD}"
    },
    {
      "name": "Navigation (Tab Bar)",
      "kind": "nav",
      "refersTo": "nav-tabbar",
      "description": "하단 탭 5개. 선택 탭은 채운 아이콘 + primary.",
      "html": "<nav class=\"ds-tabs\"><a class=\"on\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 512 512\" fill=\"currentColor\"><path d=\"M256 48 32 240h64v224h128V320h64v144h128V240h64z\"/></svg>홈</a><a><svg width=\"24\" height=\"24\" viewBox=\"0 0 512 512\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"32\"><path d=\"M256 48 80 112v128c0 112 80 192 176 224 96-32 176-112 176-224V112z\"/></svg>대피소</a></nav>",
