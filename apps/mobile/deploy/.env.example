# OpenStack 서버에서: cp .env.example .env 후 값을 채우세요. (.env 는 git 에 올라가지 않음)

# ── 웹 빌드에 들어가는 값 (EXPO_PUBLIC_* — 화면 코드에 그대로 박히므로 비밀값 금지) ──
# 비워 두면 웹은 같은 서버의 /api/ 로 요청 → nginx 가 backend 로 전달 (권장)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_TMAP_APP_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# ── 백엔드 ──
# 백엔드 이미지가 준비되면 두 줄의 # 을 지우세요. (그 전에는 웹만 실행되고 API 요청은 502)
# BACKEND_IMAGE: 백엔드 저장소에서 빌드해 올린 이미지 이름 (예: ghcr.io/팀이름/eodiisseo-backend:1.0.0)
# COMPOSE_PROFILES=backend
# BACKEND_IMAGE=
